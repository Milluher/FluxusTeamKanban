generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role               String   @default("standard") // "standard" | "admin"
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lastLoginAt        DateTime?

  boardMembers  BoardMember[]
  assignedTickets Ticket[] @relation("AssigneeRelation")
  managedTickets  Ticket[] @relation("ProductManagerRelation")
  createdTickets  Ticket[] @relation("CreatorRelation")
  comments        Comment[]
  notifications        Notification[]
  passwordResetTokens  PasswordResetToken[]
  changelogEntries     ChangelogEntry[]
  dictionaryTerms      DictionaryTerm[]
  initiatives          Initiative[]
  personas             Persona[]
  prds                 Prd[]
  prdAdminBlocks       PrdAdminBlock[] @relation("PrdAdminAssignee")
  prdApprovals         PrdApprover[]   @relation("PrdApproverUser")
}

model Board {
  id        String   @id @default(uuid())
  name      String
  // Legacy. Boards are no longer created as one kind or the other — every board
  // now has a project overview, project files, a backlog and sprints. Kept so
  // rows written before that keep their value rather than being rewritten; no
  // route or screen branches on it any more.
  type      String   @default("sprint")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  columns     Column[]
  members     BoardMember[]
  invitations Invitation[]
  sprints     Sprint[]
  canvasProjects CanvasProject[]
  productFiles   ProductFile[]
  changelogEntries ChangelogEntry[]
  prds           Prd[]
  personas        Persona[]
  dictionaryTerms DictionaryTerm[]
  initiatives     Initiative[]
}

model BoardMember {
  id      String @id @default(uuid())
  userId  String
  boardId String
  role    String @default("member") // "member" | "admin"

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([userId, boardId])
}

model Column {
  id       String @id @default(uuid())
  name     String
  order    Int
  boardId  String

  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets Ticket[]
}

model Ticket {
  id               String    @id @default(uuid())
  title            String
  description      String?
  status           String
  columnId         String
  assigneeId       String?
  productManagerId String?
  assignedDate     DateTime?
  createdById      String
  type             String?
  priority         String?
  project          String?
  epic             String?
  flow             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  order            Int       @default(0)
  sprintId         String?
  sprint           Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  productDocId     String?
  productDoc       ProductFile? @relation(fields: [productDocId], references: [id], onDelete: SetNull)
  initiativeId     String?
  initiative       Initiative?  @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  prdId            String?
  prd              Prd?         @relation(fields: [prdId], references: [id], onDelete: SetNull)

  column         Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee       User?    @relation("AssigneeRelation", fields: [assigneeId], references: [id])
  productManager User?    @relation("ProductManagerRelation", fields: [productManagerId], references: [id])
  createdBy      User     @relation("CreatorRelation", fields: [createdById], references: [id])
  comments       Comment[]

  // Self-referential many-to-many for dependencies
  dependsOn      Dependency[] @relation("DependentTicket")
  dependedOnBy   Dependency[] @relation("BlockingTicket")
  sprintHistories SprintHistory[]
  prdAdminBlock  PrdAdminBlock?
  prdApprover    PrdApprover?
}

model Dependency {
  id            String @id @default(uuid())
  ticketId      String
  dependsOnId   String

  ticket    Ticket @relation("DependentTicket", fields: [ticketId], references: [id], onDelete: Cascade)
  dependsOn Ticket @relation("BlockingTicket", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([ticketId, dependsOnId])
}

model Invitation {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  boardId   String
  createdBy String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  ticketId  String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  ticketId  String?
  boardId   String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sprint {
  id        String   @id @default(uuid())
  boardId   String
  title     String
  startDate DateTime?
  endDate   DateTime?
  status    String   @default("backlog")
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
  sprintHistories SprintHistory[]
}

model SprintHistory {
  id       String   @id @default(uuid())
  ticketId String
  sprintId String
  addedAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
}

// --- Project Overview Canvas ---
// A switchable "project" whose feature availability is presented as a
// business-model-canvas style grid of blocks. Admins curate; members view.
model CanvasProject {
  id        String   @id @default(uuid())
  boardId   String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board  Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  blocks CanvasBlock[]
}

model CanvasBlock {
  id        String   @id @default(uuid())
  projectId String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project  CanvasProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features CanvasFeature[]
}

model CanvasFeature {
  id        String   @id @default(uuid())
  blockId   String
  text      String
  active    Boolean  @default(true)
  // Whether this feature is worth a PRD. The creator answers that when they add
  // it: a "mini feature" is listed on the canvas and that is the whole of it,
  // while anything larger opens the builder there and then. Stored rather than
  // inferred from "has no PRD", which cannot tell a mini feature from one whose
  // document nobody has started yet.
  requiresPrd Boolean @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  block CanvasBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  prd   Prd?
}

// --- Product Files ---
// Named external links (e.g. Google Drive docs) that describe the product/features
// for a sprint board. Admins curate; members view + reference from tickets.
model ProductFile {
  id        String   @id @default(uuid())
  boardId   String
  title     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board   Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets Ticket[]
}

// --- Changelog ---
// Curated, admin-authored release notes. Every entry belongs to exactly one
// board: an entry is listed for everyone, but its items are only detailed to
// that board's members (admins always see full detail). There is no
// company-wide entry any more — see the 20261104_board_scoping migration.
// publishedAt = null means draft.
model ChangelogEntry {
  id          String    @id @default(uuid())
  version     String?
  title       String
  summary     String?
  items       Json      @default("[]") // [{ kind: "added"|"changed"|"fixed"|"removed", text: string }]
  boardId     String
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  board  Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
  @@index([boardId])
}

// --- Riverly Dictionary ---
// A board's own vocabulary. Any member of the board can add a term, every
// member can read one, and the creator stays attached so a definition can be
// queried at source.
//
// Terms are unique case-insensitively *within a board*, enforced by an index on
// ("boardId", LOWER("term")) that the migration adds — Prisma's schema language
// cannot express a functional index. Two boards may define the same term
// differently, which is the point of localising it.
model DictionaryTerm {
  id          String   @id @default(uuid())
  term        String
  definition  String
  boardId     String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  board     Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([term])
  @@index([boardId])
}

// --- Initiatives ---
// "A large, coordinated body of work aimed at a specific strategic goal."
//
// Owned by one board: any member of it can create an initiative and every
// member can see the board's own, along with the tickets opened to fulfil them.
//
// Tickets still point at an initiative rather than the other way round, and
// `Ticket.initiativeId` is deliberately NOT constrained to the ticket's own
// board in SQL: rows predating the 20261104_board_scoping migration legitimately
// cross boards, and dropping them would silently discard real associations. New
// links are matched board-for-board on the tickets route instead, so the rule is
// enforced going forward without rewriting history.
model Initiative {
  id          String   @id @default(uuid())
  title       String
  description String
  status      String   @default("in_progress") // "in_progress" | "achieved"
  boardId     String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@index([status])
  @@index([boardId])
}

// --- Personas ---
// The attributes of a user category, so a product decision can name who it is
// for. Owned by one board: admins curate them; the board's members read them.
//
// A fixed research template rather than free text or admin-defined attributes:
// every persona then answers the same questions, which is what makes two of
// them comparable and lets a PRD summarise one in a card.
model Persona {
  id          String   @id @default(uuid())
  name        String
  segment     String?
  description String?
  goals       String?
  painPoints  String?
  behaviours  String?
  techComfort String?  // "low" | "medium" | "high"
  boardId     String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  prds      PrdPersona[]

  @@index([name])
  @@index([boardId])
}

// --- PRD Builder ---
// The document behind a feature. Adding a feature to a project block starts
// one, so a feature on the canvas and the thinking behind it stay attached.
//
// Every section is nullable even where the brief calls it required. A PRD is
// written over days and saved as a draft from the first keystroke, so
// "required" is a condition of *publishing*, enforced on the publish route —
// not a NOT NULL that would make a half-written draft impossible to store.
//
// The section fields are the brief's, with its duplicates merged: goals and
// success metrics are asked once each (§3, §15) rather than together and again,
// and acceptance criteria belong to §14 alone rather than also hiding inside
// §5. An author meeting the same question twice does not know which box to use.
model Prd {
  id      String  @id @default(uuid())
  title   String
  version String?
  status  String  @default("draft") // "draft" | "published"

  overview           String? // §2  Overview and problem statement
  goals              String? // §3  Goals
  userStories        String? // §4  User stories and use cases
  functionalReqs     String? // §5  Functional requirements
  nonFunctionalReqs  String? // §6  Non-functional requirements
  userFlows          String? // §7  User flows and design
  assumptions        String? // §8  Assumptions, constraints, dependencies
  platforms          String? // §9  Platforms
  classification     String? // §11 "new_product" | "major_feature" | "minor_enhancement"
  inScope            String? // §12 In-Scope
  outOfScope         String? // §13 Out-of-Scope
  acceptanceCriteria String? // §14 Acceptance Criteria
  successMetrics     String? // §15 Success Metrics

  boardId         String
  canvasFeatureId String?   @unique
  createdById     String
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  board         Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  canvasFeature CanvasFeature? @relation(fields: [canvasFeatureId], references: [id], onDelete: SetNull)
  createdBy     User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  personas      PrdPersona[]
  adminBlocks   PrdAdminBlock[]
  approvers     PrdApprover[]
  tickets       Ticket[]

  @@index([boardId])
  @@index([status])
}

// §10 Target Personas, multi-select. A join rather than a list of ids, so a
// deleted persona disappears from every PRD that named it.
// A PRD's target personas. Like Ticket.initiativeId, rows created before
// 20261104_board_scoping may join a PRD to a persona on another board; the PRD
// route refuses to create new ones that do.
model PrdPersona {
  id        String @id @default(uuid())
  prdId     String
  personaId String

  prd     Prd     @relation(fields: [prdId], references: [id], onDelete: Cascade)
  persona Persona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([prdId, personaId])
}

// §16 Administrative.
//
// A block of fields the PRD's author assigns to a board member: they name the
// role, pick the person, and that person answers the two questions. The author
// owns the role and the assignee; the assignee owns the answers. Neither writes
// the other's half, which is the whole point of assigning it.
//
// `ticketId` is the task raised when the PRD is published. It is nullable
// because a block exists while the PRD is still a draft, and the brief is
// explicit that nobody is told anything until it is published.
model PrdAdminBlock {
  id            String   @id @default(uuid())
  prdId         String
  role          String
  assigneeId    String
  dataNeeded    String?  // "Data you need"
  actionsNeeded String?  // "Actions you need to take with this product"
  ticketId      String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prd      Prd     @relation(fields: [prdId], references: [id], onDelete: Cascade)
  assignee User    @relation("PrdAdminAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([prdId])
  @@index([assigneeId])
}

// §17 Approval.
//
// The author names at least two approvers — enforced when publishing, since
// that is the moment they are told. Each is pending until they act; the PRD
// counts as approved once all of them have approved.
//
// An approver can also ask for changes, with a note. That is the reason a
// published PRD can become editable again: feedback nobody can act on is not
// feedback.
model PrdApprover {
  id        String    @id @default(uuid())
  prdId     String
  userId    String
  status    String    @default("pending") // "pending" | "approved" | "changes_requested"
  note      String?
  decidedAt DateTime?
  ticketId  String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  prd    Prd     @relation(fields: [prdId], references: [id], onDelete: Cascade)
  user   User    @relation("PrdApproverUser", fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@unique([prdId, userId])
  @@index([userId])
}
